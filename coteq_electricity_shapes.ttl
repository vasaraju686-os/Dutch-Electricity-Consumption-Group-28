@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix de:   <http://example.org/dutch-energy-ontology#> .
@prefix shp:  <http://example.org/coteq/shapes#> .

# SHACL shapes for the Coteq electricity 2013 dataset
# Profiled from the data: 2503 records, each with 1 measurement, 1 location,
# 1 street, 1 network manager (shared); 1181 distinct streets.

############################################################
# EnergyRecord
############################################################
shp:EnergyRecordShape
    a sh:NodeShape ;
    sh:targetClass de:EnergyRecord ;
    sh:name "Energy record" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path de:recordIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^coteq-electricity-2013-[0-9]{4}$" ;
        sh:message "recordIdentifier must be a single string like coteq-electricity-2013-0001." ;
    ] ;
    sh:property [
        sh:path de:city ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "city must be exactly one non-empty string." ;
    ] ;
    sh:property [
        sh:path de:purchaseArea ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path de:zipCodeFrom ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}[A-Z]{2}$" ;
        sh:message "zipCodeFrom must be a Dutch postcode (4 digits + 2 capital letters)." ;
    ] ;
    sh:property [
        sh:path de:zipCodeTo ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}[A-Z]{2}$" ;
        sh:message "zipCodeTo must be a Dutch postcode (4 digits + 2 capital letters)." ;
    ] ;
    sh:property [
        sh:path de:hasMeasurement ;
        sh:nodeKind sh:IRI ;
        sh:class de:EnergyMeasurement ;
        sh:node shp:EnergyMeasurementShape ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path de:locatedIn ;
        sh:nodeKind sh:IRI ;
        sh:class de:Location ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path de:hasStreet ;
        sh:nodeKind sh:IRI ;
        sh:class de:Street ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path de:managedBy ;
        sh:nodeKind sh:IRI ;
        sh:class de:NetworkManager ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;

    # recordIdentifier must equal the local name of the record IRI
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "recordIdentifier must match the last segment of the record IRI." ;
        sh:prefixes shp: ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this <http://example.org/dutch-energy-ontology#recordIdentifier> ?value .
                FILTER (!STRENDS(STR($this), CONCAT("/", STR(?value))))
            }
        """ ;
    ] ;

    # zipCodeFrom must not sort after zipCodeTo
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "zipCodeFrom must be <= zipCodeTo." ;
        sh:prefixes shp: ;
        sh:select """
            SELECT $this ?from ?to
            WHERE {
                $this <http://example.org/dutch-energy-ontology#zipCodeFrom> ?from ;
                      <http://example.org/dutch-energy-ontology#zipCodeTo> ?to .
                FILTER (STR(?from) > STR(?to))
            }
        """ ;
    ] ;

    # Location IRI is built as <zipFrom>-<zipTo>
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Location IRI must end with <zipCodeFrom>-<zipCodeTo>." ;
        sh:prefixes shp: ;
        sh:select """
            SELECT $this ?loc
            WHERE {
                $this <http://example.org/dutch-energy-ontology#zipCodeFrom> ?from ;
                      <http://example.org/dutch-energy-ontology#zipCodeTo> ?to ;
                      <http://example.org/dutch-energy-ontology#locatedIn> ?loc .
                FILTER (!STRENDS(STR(?loc), CONCAT("/", STR(?from), "-", STR(?to))))
            }
        """ ;
    ] .

############################################################
# EnergyMeasurement
############################################################
shp:EnergyMeasurementShape
    a sh:NodeShape ;
    sh:targetClass de:EnergyMeasurement ;
    sh:name "Energy measurement" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;

    sh:property [
        sh:path de:numberOfConnections ;
        sh:datatype xsd:int ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 1 ;
    ] ;
    sh:property [
        sh:path de:annualConsumption ;
        sh:datatype xsd:double ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:message "annualConsumption must be a single non-negative xsd:double." ;
    ] ;
    sh:property [
        sh:path de:smartMeterPercentage ;
        sh:datatype xsd:double ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ; sh:maxInclusive 100 ;
    ] ;
    sh:property [
        sh:path de:activeConnectionsPercentage ;
        sh:datatype xsd:double ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ; sh:maxInclusive 100 ;
    ] ;
    sh:property [
        sh:path de:deliveryPercentage ;
        sh:datatype xsd:double ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ; sh:maxInclusive 100 ;
    ] ;
    sh:property [
        sh:path de:annualConsumptionLowTariffPercentage ;
        sh:datatype xsd:double ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:minInclusive 0 ; sh:maxInclusive 100 ;
    ] ;

    # every measurement belongs to exactly one record
    sh:property [
        sh:path [ sh:inversePath de:hasMeasurement ] ;
        sh:class de:EnergyRecord ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A measurement must be referenced by exactly one EnergyRecord." ;
    ] .

############################################################
# Location, Street, NetworkManager (identity-only resources)
############################################################
shp:LocationShape
    a sh:NodeShape ;
    sh:targetClass de:Location ;
    sh:nodeKind sh:IRI ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:pattern "/location/[0-9]{4}[A-Z]{2}-[0-9]{4}[A-Z]{2}$" ;
    sh:message "Location IRI must end with /location/<zipFrom>-<zipTo>." .

shp:StreetShape
    a sh:NodeShape ;
    sh:targetClass de:Street ;
    sh:nodeKind sh:IRI ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:pattern "/street/.+$" .

shp:NetworkManagerShape
    a sh:NodeShape ;
    sh:targetClass de:NetworkManager ;
    sh:nodeKind sh:IRI ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) .

############################################################
# Prefix declarations for the SPARQL constraints
############################################################
shp: sh:declare [
    sh:prefix "de" ;
    sh:namespace "http://example.org/dutch-energy-ontology#"^^xsd:anyURI ;
] .
